{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "npm run build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$tsc"
        },
        {
            "label": "dev",
            "type": "shell",
            "command": "npm run dev",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "migrate",
            "type": "shell",
            "command": "npm run migration:run",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "seed",
            "type": "shell",
            "command": "npm run seed:run",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "lint",
            "type": "shell",
            "command": "npm run lint",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$eslint-stylish"
        }
    ]
}